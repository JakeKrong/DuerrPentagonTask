# --- Build output ---
# Visual Studio's CMake integration builds into out/; command-line builds usually use build/
out/
build/
build-*/
cmake-build-*/

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json
# Per-user presets (CMakePresets.json is shared and committed)
CMakeUserPresets.json

# --- Qt ---
# Generated by moc/uic/rcc (AUTOMOC/AUTOUIC/AUTORCC put them in the build dir, but just in case)
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_autogen/
*.qm
# Qt Creator per-user settings
CMakeLists.txt.user*
*.pro.user*

# --- Visual Studio / VS Code ---
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
.vscode/

# --- Compiled files ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
